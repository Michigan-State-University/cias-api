# frozen_string_literal: true

# Shared SMS counter contract for campaigns.
#
# The counter lives in two services: `BodyLength` here and `cias-web`
# (`app/utils/smsBodyLength.ts`). The backend rejects a body with
# BODY_TOO_LONG / BODY_TOO_MANY_SEGMENTS, so once the two disagree the
# researcher is told "it fits" right before the API refuses it. This fixture is
# the single source both sides assert against.
#
#   bundle exec rake sms_campaigns:dump_body_length_contract
#
# After regenerating, copy the file over to cias-web:
#   app/utils/tests/fixtures/smsBodyLengthContract.json
namespace :sms_campaigns do
  desc 'Regenerates the shared SMS counter contract fixture (backend + front end)'
  task dump_body_length_contract: :environment do
    contract_web_url = 'https://web.example.test'
    contract_path = Rails.root.join('spec/fixtures/sms_campaigns/body_length_contract.json')

    klass = V1::PredefinedParticipants::SmsCampaigns::BodyLength
    original = ENV.fetch('WEB_URL', nil)
    # Pinned so the expected link lengths do not depend on the environment the
    # task happens to run in.
    ENV['WEB_URL'] = contract_web_url

    begin
      p_len = klass.personal_link_expected_length
      t_len = klass.tracked_link_expected_length
      # Appended to every body: "\n" plus the personal link.
      overhead = p_len + 1

      cases = []
      add = ->(body, variables = [], note = nil) { cases << { body: body, variables: variables, note: note } }

      # Segment thresholds, on both sides of every boundary.
      { 'GSM-7' => [160, 161, 306, 307, 459, 460], 'UCS-2' => [70, 71, 134, 135, 201, 202] }
        .each do |encoding, totals|
          char = encoding == 'GSM-7' ? 'a' : 'ą'
          totals.each do |total|
            len = total - overhead
            add.call(char * len, [], "#{encoding}, #{total} units") if len >= 0
          end
        end

      # An extension character counts twice, which shifts the boundary by one.
      [305, 306].each do |total|
        len = total - overhead - 1
        add.call("#{'a' * len}€", [], "GSM-7 with an extension character, #{total} units") if len >= 0
      end

      # Length limit (max_body_length), on both sides.
      limit = Settings.sms_campaigns.max_body_length
      [limit - 1, limit, limit + 1].each do |total|
        len = total - overhead
        add.call('a' * len, [], "length limit, #{total} units") if len >= 0
      end

      # Segment limit (max_segments). Only reachable together with the length
      # limit: UCS-2 fits 67 units per segment, so 24 segments are not used up
      # until well past max_body_length.
      segments_over = (Settings.sms_campaigns.max_segments + 1) * klass::UCS2_SEGMENT_LENGTHS.last
      add.call('ą' * (segments_over - overhead), [], "segment limit, #{segments_over} UCS-2 units")

      # Link variables.
      add.call('::a:: and ::a:: plus ::b::', ['a'], 'repeated variable, the second one without a link')
      add.call('::a::::b::::a::', %w[a b], 'variables with no separator')
      add.call('text with an ::unknown:: variable', [], 'a variable without a link is not expanded')
      add.call('::a::', ['a'], 'nothing but the variable')

      # Edge characters.
      add.call('', [], 'empty body')
      add.call("\n\r\f", [], 'control characters: CR and LF are GSM-7, FF is an extension')
      add.call('😀', [], 'a character outside the BMP is two UTF-16 units')
      add.call('😀🙂中ｱ', [], 'mixture of non-GSM-7 characters')
      add.call('€[]{}\\^~|', [], 'extension characters only')
      add.call('Zażółć gęślą jaźń', [], 'Polish diacritics force UCS-2')

      # Realistic bodies.
      add.call('Zapraszamy do udziału w badaniu. Kliknij link poniżej, aby rozpocząć.', [], 'realistic Polish body')
      add.call('Join our study today. Tap the link below to begin.', [], 'realistic English body')
      add.call('Reminder: ::link:: is waiting for you.', ['link'], 'realistic reminder with a link')

      rows = cases.map do |c|
        measure = klass.new(c[:body], c[:variables])
        {
          note: c[:note],
          body: c[:body],
          variables: c[:variables],
          length: measure.length,
          segments: measure.segments,
          gsm7: measure.gsm7?,
          codes: measure.codes
        }
      end

      payload = {
        '_README' => 'Generated by `rake sms_campaigns:dump_body_length_contract`. ' \
                     'Do not edit by hand. Both cias-api and cias-web assert against it.',
        'webUrl' => contract_web_url,
        'meta' => {
          'personalLinkExpectedLength' => p_len,
          'trackedLinkExpectedLength' => t_len,
          'gsm7SegmentLengths' => klass::GSM7_SEGMENT_LENGTHS,
          'ucs2SegmentLengths' => klass::UCS2_SEGMENT_LENGTHS,
          'maxBodyLength' => Settings.sms_campaigns.max_body_length,
          'maxSegments' => Settings.sms_campaigns.max_segments,
          'maxReminderDaysAfter' => Settings.sms_campaigns.max_reminder_days_after
        },
        'cases' => rows
      }

      FileUtils.mkdir_p(contract_path.dirname)
      contract_path.write("#{JSON.pretty_generate(payload)}\n")
      puts "Wrote #{rows.size} cases to #{contract_path}"
    ensure
      ENV['WEB_URL'] = original
    end
  end
end

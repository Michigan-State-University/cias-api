# .semgrepignore -- exclude patterns for Semgrep SAST analysis
# Gitignore-style patterns, one per line. Lines starting with # are comments.
# Required: htd-cq runs semgrep with --no-git-ignore, so .gitignore is NOT honored.

# Common
.git/
htd-cq-output/
.htd-cq-coverage/
.claude/
.idea/
.vscode/

# Rails
vendor/bundle/
.bundle/
log/
tmp/
public/assets/
public/packs/
node_modules/
coverage/
storage/
